{
  "enforce": true,
  "product": ["docs/**", "harness/**"],
  "exempt": ["docs/DECISIONS.md"],
  "main_thread_file_limit": 999999,
  "verifiers": ["critic"],
  "write_agents": ["maker"],
  "close_gate": true,
  "approval_gate": true,
  "max_close_blocks": 2,
  "metrics": true,
  "verify_commands": [
    "python3 harness/tests/test_gate.py",
    "python3 harness/tests/test_docs_sync.py"
  ],
  "require_verdict": true
}
